+		if (voxelId == 1720u) voxelId = 1715u; // OBS07: glow shapes give white shape light
+
+		// OBS07: AE2 full bright parts (screens, controller, smart cable channels) give light, cables let it pass
+		if (voxelId == 291u || voxelId == 215u || voxelId == 266u) {
+			#ifdef OBS07_MICROBLOCK_LPV
+				vec3 obs07Face = textureLod(gtexture, mc_midTexCoord.xy, 4.0).rgb * gl_Color.rgb;
+				bool obs07Glow = gl_MultiTexCoord1.x > 239.0 && gl_MultiTexCoord1.y > 239.0 && max(max(obs07Face.r, obs07Face.g), obs07Face.b) > 0.35;
+				if (obs07Glow) voxelId = Obs07DyeLight(0.7);
+				else {
+					if (voxelId == 291u) voxelId = 50u; // BLOCK_LPV_IGNORE
+					obs07Shared = true;
+				}
+			#else
+				if (voxelId == 291u) voxelId = 50u;
+			#endif
+		}
+
+		// OBS07: microblocks share one id, only the glowing ones give light
+		if (voxelId == 510u) {
+			voxelId = 0u;
+			obs07Microblock = true;
+			#ifdef OBS07_MICROBLOCK_LPV
+				voxelId = Obs07MicroblockLight();
+				voxelId = Obs07ShapeLamp(voxelId);
+			#endif
+		}
+
+		// OBS07: glowing APN shapes give light
+		#ifdef OBS07_EMISSIVE_LPV
+		#ifdef OBS07_MICROBLOCK_LPV
+			bool obs07ShapeId = voxelId == 50u;
+			#if defined IS_ANGELICA || MC_VERSION < 11300
+				// GTNH slabs, stairs and partial blocks (51, 52) can glow through PBR too
+				obs07ShapeId = obs07ShapeId || voxelId == 51u || voxelId == 52u;
+			#endif
+			if (obs07ShapeId) {
+				uint obs07ShapeLight = Obs07MicroblockLight();
+				#ifdef IRIS_FEATURE_BLOCK_EMISSION_ATTRIBUTE
+					if (obs07ShapeLight == 0u && at_midBlock.w > 0) obs07ShapeLight = uint(BLOCK_LIGHT_1 + at_midBlock.w - 1);
+				#endif
+				if (obs07ShapeLight != 0u) voxelId = Obs07ShapeLamp(obs07ShapeLight);
+			}
+		#endif
+		#endif
