+				ivec3 obs07Cell = ivec3(floor(rayProgress + fract(cameraPosition))) + int(VoxelSize / 2u);
+				float obs07Jitter = 0.6 + 0.8 * fract(dither + float(i) * 0.618034);
+				float obs07Ground = 1.4 + Obs07GroundBelow(obs07Cell - ivec3(0, max(int(1.5 * obs07Jitter), 1), 0)) * 0.7
+				                  + Obs07GroundBelow(obs07Cell - ivec3(0, int(3.5 * obs07Jitter + 0.5), 0)) * 0.5
+				                  + Obs07GroundBelow(obs07Cell - ivec3(0, int(6.5 * obs07Jitter + 0.5), 0)) * 0.3
+				                  + Obs07GroundBelow(obs07Cell - ivec3(0, int(10.5 * obs07Jitter + 0.5), 0)) * 0.2;
+				float obs07Density = OBS07_LIGHT_FOG * 0.003 * obs07Ground * obs07Motion * LpvFadeF * obs07DayLevel;
+				float obs07Step = 1.0 - exp(-dd * LPVRayLength * obs07Density);
+				// blurred lpv so the glow fades out round instead of boxy
+				vec3 obs07Near = SampleLpvLinear(lpvPos + vec3(4.0, 0.0, 0.0)).rgb + SampleLpvLinear(lpvPos - vec3(4.0, 0.0, 0.0)).rgb
+				               + SampleLpvLinear(lpvPos + vec3(0.0, 0.0, 4.0)).rgb + SampleLpvLinear(lpvPos - vec3(0.0, 0.0, 4.0)).rgb
+				               + SampleLpvLinear(lpvPos + vec3(0.0, 4.0, 0.0)).rgb + SampleLpvLinear(lpvPos - vec3(0.0, 4.0, 0.0)).rgb;
+				vec3 obs07Far = SampleLpvLinear(lpvPos + vec3(5.2, 5.2, 5.2)).rgb + SampleLpvLinear(lpvPos + vec3(-5.2, 5.2, -5.2)).rgb
+				              + SampleLpvLinear(lpvPos + vec3(5.2, -5.2, -5.2)).rgb + SampleLpvLinear(lpvPos + vec3(-5.2, -5.2, 5.2)).rgb;
+				vec3 obs07LightIn = sampleColor * 0.4 + obs07Near * (0.4 / 6.0) + obs07Far * (0.35 / 4.0);
+				float obs07Luma = luma(obs07LightIn);
+				// drop the faintest light, it adds up into a slab from far away
+				vec3 obs07Light = mix(vec3(obs07Luma), obs07LightIn, 0.9) * smoothstep(0.004, 0.04, obs07Luma) * 0.75;
+				obs07Fog += obs07Light * (obs07Step * obs07FogTransmittance);
+				obs07FogAmbient += obs07Step * obs07FogTransmittance;
+
+				vec3 obs07ShadowPos = obs07ShadowStart + d * obs07ShadowRay;
+				#ifdef DISTORT_SHADOWMAP
