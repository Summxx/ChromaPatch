+				obs07ShadowPos = obs07ShadowPos * vec3(0.5, 0.5, 0.5 / 6.0) + 0.5;
+				float obs07Lit = clamp(obs07ShadowPos, 0.0, 1.0) == obs07ShadowPos ? texture(shadowtex0HW, obs07ShadowPos).x : 1.0;
+				obs07FogDirect += vec3(obs07Lit * obs07Step * obs07FogTransmittance);
+				obs07FogTransmittance *= 1.0 - obs07Step;
+			#endif
