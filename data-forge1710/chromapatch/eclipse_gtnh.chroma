+#if defined IS_ANGELICA && !defined ENTITIES && !defined BLOCKENTITIES && !defined HAND
+	// OBS07: nearest candle light id to a glowing microblock face colour, white when pale, 0 without PBR emission
+	uniform sampler2D gtexture;
+	uniform sampler2D specular;
+
+	int Obs07FaceLamp() {
+		vec2 midUV = mc_midTexCoord.xy;
+		float emission = max(textureLod(specular, midUV, 0.0).a, textureLod(specular, midUV, 2.0).a);
+		if (emission <= 0.0 || emission > 0.999) return 0;
+
+		vec3 c = textureLod(gtexture, mc_midTexCoord.xy, 4.0).rgb * gl_Color.rgb;
+		c /= max(max(c.r, c.g), max(c.b, 0.001));
+		if (min(min(c.r, c.g), c.b) > 0.7) return 169;
+
+		const vec3 dyeColor[12] = vec3[12](
+			vec3(1.00, 0.51, 0.12), vec3(1.00, 0.39, 0.95), vec3(0.27, 0.82, 1.00), vec3(1.00, 0.85, 0.24),
+			vec3(0.64, 1.00, 0.16), vec3(1.00, 0.57, 0.70), vec3(0.14, 1.00, 1.00), vec3(0.75, 0.27, 1.00),
+			vec3(0.35, 0.40, 1.00), vec3(1.00, 0.64, 0.38), vec3(0.76, 1.00, 0.18), vec3(1.00, 0.26, 0.22)
+		);
+		const int dyeLight[12] = int[12](153, 149, 137, 173, 145, 157, 125, 161, 117, 121, 133, 165);
+
+		int best = 169;
+		float bestDist = 1e9;
+		for (int i = 0; i < 12; i++) {
+			vec3 d = c - dyeColor[i];
+			float dist = dot(d, d);
+			if (dist < bestDist) { bestDist = dist; best = dyeLight[i]; }
+		}
+		return best;
+	}
+#endif
+
