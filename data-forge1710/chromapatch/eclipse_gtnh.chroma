+// Kura+OBS07 Patches
+
+#ifdef OBS07_MICROBLOCK_LPV
+	// OBS07: glowing microblocks, from their PBR emission
+	uniform sampler2D gtexture;
+	uniform sampler2D specular;
+
+	// nearest 4 candle light to the texture colour, white when pale
+	uint Obs07DyeLight(float whiteLimit) {
+		vec3 c = textureLod(gtexture, mc_midTexCoord.xy, 4.0).rgb * gl_Color.rgb;
+		c /= max(max(c.r, c.g), max(c.b, 0.001));
+		if (min(min(c.r, c.g), c.b) > whiteLimit) return 169u;
+
+		const vec3 dyeColor[12] = vec3[12](
+			vec3(1.00, 0.51, 0.12), vec3(1.00, 0.39, 0.95), vec3(0.27, 0.82, 1.00), vec3(1.00, 0.85, 0.24),
+			vec3(0.64, 1.00, 0.16), vec3(1.00, 0.57, 0.70), vec3(0.14, 1.00, 1.00), vec3(0.75, 0.27, 1.00),
+			vec3(0.35, 0.40, 1.00), vec3(1.00, 0.64, 0.38), vec3(0.76, 1.00, 0.18), vec3(1.00, 0.26, 0.22)
+		);
+		const uint dyeLight[12] = uint[12](153u, 149u, 137u, 173u, 145u, 157u, 125u, 161u, 117u, 121u, 133u, 165u);
+
+		uint best = 169u;
+		float bestDist = 1e9;
+		for (int i = 0; i < 12; i++) {
+			vec3 d = c - dyeColor[i];
+			float dist = dot(d, d);
+			if (dist < bestDist) { bestDist = dist; best = dyeLight[i]; }
+		}
+		return best;
+	}
+
+	// glowing microblocks and shapes light like a lamp, floor wells only (see setup)
+	uint Obs07ShapeLamp(uint id) {
+		return (id >= 109u && id <= 177u) ? 1700u + (id - 109u) / 4u : id;
+	}
+
+	uint Obs07MicroblockLight() {
+		vec2 midUV = mc_midTexCoord.xy;
+		// mip 3 too, animated screens (GT tanks) stop blinking
+		float emission = max(max(textureLod(specular, midUV, 0.0).a, textureLod(specular, midUV, 2.0).a), textureLod(specular, midUV, 3.0).a);
+		if (emission <= 0.0 || emission > 0.999) return 0u;
+		return Obs07DyeLight(0.7);
+	}
+#endif
+
+
+
=3
=4
=5
+	bool obs07Microblock = false;
+	bool obs07Shared = false;
+	bool obs07Unlisted = false;
