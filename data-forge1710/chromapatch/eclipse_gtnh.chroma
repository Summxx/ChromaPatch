+#if defined OVERWORLD_SHADER && defined IS_LPV_ENABLED
+	// OBS07: rain only wets surfaces open to the sky
+	#include "/lib/voxel_common.glsl"
+
+	bool Obs07OpenSky(vec3 playerPos, int maxHeight) {
+		for (int i = 1; i <= maxHeight; i++) {
+			ivec3 voxelPos = ivec3(floor(playerPos + vec3(0.0, i, 0.0) + fract(cameraPosition)) + VoxelSize3 / 2u);
+			if (clamp(voxelPos, ivec3(0), ivec3(VoxelSize - 1u)) != voxelPos) break;
+			uint id = imageLoad(imgVoxelMask, voxelPos).r % 2000u;
+			if (id != 0u && id != uint(BLOCK_AIR_WAVING)) return false; // leaves let the rain through
+		}
+		return true;
+	}
+
+	// a bit of water under roof edges
+	float Obs07RainReaches(vec3 worldPos, vec3 flatNormal) {
+		vec3 playerPos = worldPos - cameraPosition + flatNormal * 0.1;
+		if (Obs07OpenSky(playerPos, 48)) return 1.0;
+
+		const float flowDist = 4.0;
+		float reach = flowDist * (0.6 + 0.8 * texture(noisetex, worldPos.xz * 0.03).b);
+		float wet = 0.0;
+		// dithered, TAA smooths it
+		float jitter = fract(52.9829189 * fract(dot(gl_FragCoord.xy, vec2(0.06711056, 0.00583715))) + float(frameCounter % 64) * 0.618034);
+		for (int r = 1; r <= 5; r++) {
+			float dist = (float(r) - jitter) * 0.9;
+			if (dist > reach) break;
+			for (int a = 0; a < 8; a++) {
+				float ang = float(a) * 0.785398 + float(r) * 0.39;
+				vec3 offset = vec3(cos(ang), 0.0, sin(ang)) * dist;
+				if (Obs07OpenSky(playerPos + offset, 16)) {
+					wet = max(wet, pow(1.0 - dist / reach, 1.6));  // long soft tail
+					break;
+				}
+			}
+			if (wet > 0.0) break;
+		}
+		return wet;
+	}
+#endif
+
