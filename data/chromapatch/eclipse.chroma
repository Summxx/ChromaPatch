+#ifdef OVERWORLD_SHADER
+// OBS07: godrays, tinted by stained glass
+vec3 Obs07Godrays(vec3 viewPos, float dither, vec3 lightColor){
+	float rayLength = length(viewPos);
+	vec3 rayDir = mat3(gbufferModelViewInverse) * (viewPos / max(rayLength, 1e-6));
+	float marchLength = min(rayLength, 100.0);
+
+	vec3 start = toShadowSpaceProjected(vec3(0.0));
+	vec3 shadowRay = toShadowSpaceProjected(viewPos * (marchLength / max(rayLength, 1e-6))) - start;
+
+	const int steps = 32;
+	vec3 lit = vec3(0.0);
+	for (int i = 0; i < steps; i++){
+		vec3 progress = start + shadowRay * ((float(i) + dither) / float(steps));
+		#ifdef DISTORT_SHADOWMAP
+			float distortFactor = calcDistort(progress.xy);
+		#else
+			float distortFactor = 1.0;
+		#endif
+		vec3 shadowPos = vec3(progress.xy * distortFactor, progress.z) * vec3(0.5, 0.5, 0.5 / 6.0) + 0.5;
+		if (clamp(shadowPos, 0.0, 1.0) != shadowPos) continue;
+
+		#ifdef TRANSLUCENT_COLORED_SHADOWS
+			float opaque = texture(shadowtex1HW, shadowPos).x;
+			if (opaque <= 0.0) continue;
+			vec3 tint = vec3(1.0);
+			if (texture(shadowtex0HW, shadowPos).x < 1.0) tint = Obs07GlassShadow(texture(shadowcolor0, shadowPos.xy));
+			lit += tint * opaque;
+		#else
+			lit += texture(shadowtex0HW, shadowPos).x;
+		#endif
+	}
+
+	// stronger at sunrise and sunset
+	float time = float(obs07DayTime % 24000);
+	float vlStrength;
+	if (time <= 12500.0)      vlStrength = pow(abs(time -  6000.0) / 6500.0, 2.0);
+	else if (time <= 23500.0) vlStrength = pow(abs(time - 18000.0) / 5500.0, 2.0);
+	else                      vlStrength = pow(abs(time - 30000.0) / 6500.0, 2.0);
+	vlStrength = (vlStrength * 0.4 + 0.5) * (dot(WsunVec, rayDir) * 0.25 + 0.75);
+
+	const float g = 0.8;
+	float phaseB = 1.0 + g * g - 2.0 * g * vlStrength;
+	float phase = 1.5 * (1.0 - g * g) * (1.0 + vlStrength * vlStrength) / (phaseB * sqrt(phaseB) * (2.0 + g * g));
+	float scale = 0.5 / (WsunVec.y * WsunVec.y * 2.0 + 0.4);
+
+	vec3 shaftColor = mix(vec3(dot(lightColor, vec3(0.2126, 0.7152, 0.0722))), lightColor, OBS07_GODRAYS_SATURATION);
+	return shaftColor * (lit * (marchLength / float(steps)) * 0.0016 * phase * scale * (1.0 - rainStrength) * OBS07_GODRAYS);
+}
+#endif
+
+#if defined OVERWORLD_SHADER && defined OBS07_FOG_DRIFT && defined IS_LPV_ENABLED && defined LPV_VL_FOG_ILLUMINATION
+	float Obs07GroundBelow(ivec3 cell){
+		if (clamp(cell, ivec3(0), ivec3(VoxelSize - 1u)) != cell) return 0.0;
+		uint id = imageLoad(imgVoxelMask, cell).r;
+		return id != 0u && id != 50u && id < 2000u ? 1.0 : 0.0; // 50 = BLOCK_LPV_IGNORE, 2000+ = entities
+	}
+#endif
+
