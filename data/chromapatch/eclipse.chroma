+option.DOF_DISPERSION_MULT.comment = §bWhat is this?§r This adds a color offset for red and blue, for a cool effect.
+
+# OBS07: atmosphere
+screen.Atmosphere = Atmosphere
+screen.Atmosphere.comment = Night fog drifting with the wind, godrays, floating dust, light wells of recessed lamps and light through glass.
+screen.Night_Light_Fog = Night Light Fog
+screen.Night_Light_Fog.comment = The fog lit by lamps, drifting with the wind.
+screen.Godrays_And_Dust = Godrays and Dust
+screen.Lamp_Light_Wells = Lamp Light Wells
+screen.Lamp_Light_Wells.comment = Recessed microblock lamps light up the fog above them (below them for ceiling lamps).
+screen.Glass_Light = Glass
+
+option.OBS07_FOG_DRIFT = Drifting Fog
+option.OBS07_FOG_DRIFT.comment = Fog moves with the wind in banks and changes a bit every night. Off = still fog.
+option.OBS07_LIGHT_FOG = Night Fog Thickness
+option.OBS07_LIGHT_FOG.comment = Thickness of the night fog. 0 = base fog only.
+option.OBS07_LIGHT_FOG_AMBIENT = Night Fog Ambient
+option.OBS07_LIGHT_FOG_AMBIENT.comment = Night sky light in the fog, so it shows away from lamps. 0 = lamps only.
+option.OBS07_LIGHT_FOG_MOON = Night Fog Moonlight
+option.OBS07_LIGHT_FOG_MOON.comment = Moonlight in the night fog, with building shadows. 0 = off.
+option.OBS07_LIGHT_FOG_MOTION = Drift Speed
+option.OBS07_LIGHT_FOG_MOTION.comment = How fast the fog banks move with the wind.
+option.OBS07_LIGHT_FOG_DAY = Daytime Amount
+option.OBS07_LIGHT_FOG_DAY.comment = How much of the lamp lit fog and the light wells stays in daylight. 1 = as much as at night.
+
+option.OBS07_GODRAYS = Godrays
+option.OBS07_GODRAYS.comment = Light shafts, strongest at sunrise and sunset, tinted by glass. 0 = off.
+option.OBS07_GODRAYS_SATURATION = Godray Colour
+option.OBS07_GODRAYS_SATURATION.comment = How much of the orange of a low sun the shafts keep. 0 = white.
+option.OBS07_DUST = Dust Motes
+option.OBS07_DUST.comment = Floating dust in sunbeams at sunrise and sunset, and in light wells. 0 = off.
+option.OBS07_DUST_AMOUNT = Dust Amount
+option.OBS07_DUST_AMOUNT.comment = How many motes float in the air.
+option.OBS07_DUST_DAY = Dust in Daylight
+option.OBS07_DUST_DAY.comment = Dust kept when the sun is high. 0 = sunrise and sunset only.
+option.OBS07_DUST_SPEED = Dust Speed
+
+option.OBS07_LAMP_BEAM = Light Wells
+option.OBS07_LAMP_BEAM.comment = Glow above single recessed lamps (floor, wall top or ceiling). 0 = off.
+option.OBS07_LAMP_BEAM_MODE = Light Well Shape
+option.OBS07_LAMP_BEAM_MODE.comment = Cone: a beam rising from the lamp. Glow: soft light above it.
+value.OBS07_LAMP_BEAM_MODE.0 = Cone
+value.OBS07_LAMP_BEAM_MODE.1 = Glow
+option.OBS07_LAMP_BEAM_LENGTH = Cone Fade
+option.OBS07_LAMP_BEAM_LENGTH.comment = Height in blocks where the cone has lost half its light.
+option.OBS07_LAMP_BEAM_HEIGHT = Search Height
+option.OBS07_LAMP_BEAM_HEIGHT.comment = How far above or below the view the lamps are looked for, in blocks. §aPERFORMANCE COST:§r medium
+option.OBS07_LAMP_BEAM_FOG = Thicker Fog In The Glow
+option.OBS07_LAMP_BEAM_FOG.comment = Thicker fog inside the light wells so they stand out.
+option.OBS07_DUST_MOTES_IN_BEAM = Dust in Light Wells
+
+option.OBS07_EMISSIVE_LPV = Glowing Blocks Give Light
+option.OBS07_EMISSIVE_LPV.comment = Blocks that only glow through the resource pack (neon strips, modded lamps) light their surroundings.
+option.OBS07_DARK_GLASS_LIGHT = Dark Glass Light
+option.OBS07_DARK_GLASS_LIGHT.comment = Sunlight let through by dark tinted glass. 0 = blocks it.
+option.OBS07_GLASS_SUN = Sunlit Glass
+option.OBS07_GLASS_SUN.comment = Soft sunlit patch on tinted glass. 0 = off.
