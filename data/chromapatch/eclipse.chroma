+
+
+	// Kura+OBS07 Patches: CB bakes face shading and AO in the vertex colour, keep only the AO like vanilla blocks
+
+	#if !defined ENTITIES && !defined BLOCKENTITIES && !defined HAND
+	if (data_out.blockID == 510) {
+		float cbShade = gl_Normal.y > 0.5 ? 1.0 : (gl_Normal.y < -0.5 ? 0.5 : (abs(gl_Normal.z) > 0.5 ? 0.8 : 0.6));
+		float cbMax = max(max(gl_Color.r, gl_Color.g), gl_Color.b);
+		data_out.color.rgb = gl_Color.rgb / max(cbMax, 0.001);
+		data_out.color.a = clamp(cbMax / cbShade, 0.0, 1.0);
+		data_out.blockID = 0;
+	}
+	#endif
+
+
+
=3
=4
=5
