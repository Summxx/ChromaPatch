@new shaders/lib/obs07_atmosphere.glsl 75 1
|// OBS07: atmosphere helpers
|
|uniform int obs07DayTime;
|
|vec3 Obs07Hash3(inout uint seed){
|	seed = seed * 747796405u + 2891336453u;
|	uvec3 h = uvec3(seed, seed * 277803737u, seed * 2654435769u);
|	h = (h >> ((h >> 28u) + 4u)) ^ h;
|	h *= 277803737u;
|	return vec3((h >> 22u) ^ h) * (1.0 / 4294967296.0);
|}
|
|// one random value per period, so nights differ a bit
|float Obs07DailyRandom(int periodOffset, int periodLength, uint salt){
|	int period = (obs07DayTime + periodOffset) / periodLength;
|	uint seed = uint(period) * 747796405u + salt;
|	return Obs07Hash3(seed).x;
|}
|
|// 1 at night, 0 by day
|float Obs07Night(){
|	return clamp(0.5 - sunElevation * 5.0, 0.0, 1.0);
|}
|
|float Obs07Noise3D(vec3 pos){
|	vec3 p = floor(pos);
|	vec3 f = pos - p;
|	f = f * f * (3.0 - 2.0 * f);
|
|	// same layout as the fog noise
|	vec2 uv = p.xz + f.xz + p.y * vec2(0.0, 193.0);
|	vec2 noise = textureLod(noisetex, uv / 512.0, 0.0).yx;
|
|	return mix(noise.x, noise.y, f.y);
|}
|
|// same wind as the waving leaves
|vec3 Obs07WindWave(vec3 pos, float wind){
|	float magnitude = sin(wind * 0.0027 + pos.x + pos.y) * 0.04 + 0.04;
|	float d0 = sin(wind * 0.0127);
|	float d1 = sin(wind * 0.0089);
|	float d2 = sin(wind * 0.0114);
|	vec3 wave;
|	wave.x = magnitude * sin(wind * 0.0224 + d1 + d2 + pos.x - pos.z + pos.y);
|	wave.y = magnitude * sin(wind * 0.0015 + d2 + d0 + pos.x);
|	wave.z = magnitude * sin(wind * 0.0063 + d0 + d1 - pos.x + pos.z + pos.y);
|	return wave;
|}
|
|// drifting fog banks, about 1 on average
|float Obs07FogMotion(vec3 worldPos){
|	float time = frameTimeCounter * OBS07_LIGHT_FOG_MOTION;
|	vec3 sway = Obs07WindWave(worldPos * vec3(0.04, 0.03, 0.04), time * 60.0) * vec3(70.0, 25.0, 70.0);
|	vec3 pos = worldPos + sway - vec3(time * 6.0, 0.0, 0.0);
|
|	// domain warp
|	vec3 warp = vec3(Obs07Noise3D(pos * 0.04), Obs07Noise3D(pos * 0.04 + 17.3), Obs07Noise3D(pos * 0.04 + 31.7)) - 0.235;
|	vec3 warped = pos + warp * 40.0;
|
|	float noise = Obs07Noise3D(warped * vec3(0.07, 0.1, 0.07)) * 0.55
|	            + Obs07Noise3D((warped - vec3(time * 4.0, time * 0.6, 0.0)) * vec3(0.18, 0.25, 0.18)) * 0.3
|	            + Obs07Noise3D((pos - vec3(time * 2.0, time * 0.4, 0.0)) * vec3(0.5, 0.6, 0.5)) * 0.15;
|	// noisetex is mostly 0.05-0.45
|	return 0.1 + 1.8 * smoothstep(0.15, 0.35, noise);
|}
|
|// per night fog amount
|float Obs07NightFogAmount(){
|	return mix(1.0, mix(0.65, 1.05, Obs07DailyRandom(6000, 24000, 17u)), Obs07Night());
|}
|
|float Obs07HenyeyGreenstein(float cosTheta, float g){
|	float g2 = g * g;
|	return (1.0 - g2) / (4.0 * 3.14159265 * pow(1.0 + g2 - 2.0 * g * cosTheta, 1.5));
|}
@new shaders/lib/obs07_atmosphere_final.glsl 372 1
|// OBS07: dust motes and lamp wells, full resolution (composite4)
|
|const bool shadowHardwareFiltering = true;
|uniform sampler2DShadow shadowtex0HW;
|uniform mat4 shadowModelView;
|uniform mat4 shadowProjection;
|
|uniform usampler1D texBlockData;
|uniform sampler3D texLpv1;
|uniform sampler3D texLpv2;
|
|#if !(RAINBOW > 0 && defined OVERWORLD_SHADER)
|	#include "/lib/hsv.glsl"
|#endif
|#include "/lib/lpv_common.glsl"
|#include "/lib/lpv_render.glsl"
|#include "/lib/voxel_common.glsl"
|
|// lit by the sun or moon
|bool Obs07SunLit(vec3 playerPos){
|	#ifdef CUSTOM_MOON_ROTATION
|		vec3 p = mat3(customShadowMatrixSSBO) * playerPos + customShadowMatrixSSBO[3].xyz;
|	#else
|		vec3 p = mat3(shadowModelView) * playerPos + shadowModelView[3].xyz;
|	#endif
|	p = vec3(shadowProjection[0].x, shadowProjection[1].y, shadowProjection[2].z) * p + shadowProjection[3].xyz;
|
|	#ifdef DISTORT_SHADOWMAP
|		const float k = 1.8;
|		const float d0 = 0.04 + (1.0 - clamp(shadowDistance - 64.0, 0.0, 1.0)) * 0.1;
|		float a = exp(d0);
|		float b = (exp(0.61) - a) * 150.0 / 128.0;
|		p.xy /= log(length(p.xy) * b + a) * k;
|	#endif
|
|	vec3 shadowPos = p * vec3(0.5, 0.5, 0.5 / 6.0) + 0.5;
|	if (clamp(shadowPos, 0.0, 1.0) != shadowPos) return false;
|	return texture(shadowtex0HW, shadowPos).x > 0.5;
|}
|
|vec3 Obs07LpvLight(vec3 playerPos){
|	return SampleLpvLinear(GetLpvPosition(playerPos)).rgb * TORCH_AMOUNT;
|}
|
|// dust motes, one per cell at most, lit by the sun and the lpv
|void Obs07DustMotes(inout vec3 color, vec3 playerPos, vec3 lightColor){
|	// sunrise/sunset only, not against bright backgrounds
|	float lowSun = smoothstep(0.45, 0.1, sunElevation) * smoothstep(-0.04, 0.02, sunElevation);
|	float strength = OBS07_DUST * mix(OBS07_DUST_DAY, 1.0, lowSun) * float(sunElevation > -0.04) * mix(0.95, 1.25, Obs07DailyRandom(6000, 12000, 91u));
|	strength *= 1.0 - smoothstep(0.2, 0.8, luma(color) * exposureSSBO);
|	if (strength <= 0.001) return;
|
|	float rayDist = length(playerPos);
|	vec3 rayDir = playerPos / max(rayDist, 1e-6);
|	float maxDist = min(rayDist, 16.0);
|
|	vec3 rayOrigin = gbufferModelViewInverse[3].xyz + fract(cameraPosition);
|	ivec3 cameraCell = ivec3(floor(cameraPosition));
|
|	vec3 cell = floor(rayOrigin);
|	vec3 cellStep = sign(rayDir);
|	vec3 invDir = 1.0 / max(abs(rayDir), 1e-6);
|	vec3 tMax = (cellStep * (cell - rayOrigin) + max(cellStep, 0.0)) * invDir;
|
|	vec3 sunLight = lightColor * (0.3 + Obs07HenyeyGreenstein(dot(rayDir, WsunVec), 0.6) * 1.5);
|	float time = frameTimeCounter * OBS07_DUST_SPEED;
|
|	vec3 dust = vec3(0.0);
|	for (int i = 0; i < 48; i++){
|		ivec3 worldCell = cameraCell + ivec3(cell);
|		uint seed = uint(worldCell.x) * 73856093u ^ uint(worldCell.y) * 19349663u ^ uint(worldCell.z) * 83492791u;
|		vec3 h1 = Obs07Hash3(seed);
|
|		if (h1.x < OBS07_DUST_AMOUNT){
|			vec3 h2 = Obs07Hash3(seed);
|			vec3 mote = cell + 0.5 + 0.3 * sin(time * (0.15 + h2 * 0.25) + h1 * 6.2831853);
|
|			float t = dot(mote - rayOrigin, rayDir);
|			if (t > 0.1 && t < maxDist){
|				vec3 offset = rayOrigin + rayDir * t - mote;
|				float radius = max(0.007 + h2.x * 0.006, t * 0.0008);
|				float glint = exp2(-dot(offset, offset) / (radius * radius) * 1.442695);
|
|				if (glint > 0.01){
|					vec3 motePos = mote - fract(cameraPosition);
|					vec3 moteLight = Obs07LpvLight(motePos) * 0.3;
|					if (Obs07SunLit(motePos)) moteLight += sunLight;
|
|					float twinkle = 0.5 + 0.5 * pow(0.5 + 0.5 * sin(frameTimeCounter * (1.5 + h2.y * 3.0) + h2.z * 6.2831853), 4.0);
|					dust += moteLight * (glint * twinkle * (1.0 - smoothstep(8.0, 16.0, t)) * (0.012 / max(radius, 0.012)));
|				}
|			}
|		}
|
|		float tNext = min(min(tMax.x, tMax.y), tMax.z);
|		if (tNext > maxDist) break;
|		vec3 stepMask = step(tMax, vec3(tNext));
|		cell += cellStep * stepMask;
|		tMax += invDir * stepMask;
|	}
|
|	color += dust * strength;
|}
|
|// lamp wells: glow above floor lamps and below ceiling lamps
|
|int obs07Voxel(ivec3 cell){
|	if (clamp(cell, ivec3(0), ivec3(VoxelSize - 1u)) != cell) return 0;
|	uint id = imageLoad(imgVoxelMask, cell).r;
|	return id < 2000u ? int(id) : 0; // 2000+ = entities
|}
|
|bool Obs07Solid(ivec3 cell){
|	int id = obs07Voxel(cell);
|	return id != 0 && id != 50; // 50 = BLOCK_LPV_IGNORE
|}
|
|// 4 candle lights, see voxel_write
|bool Obs07IsLamp(int id){
|	return id >= 109 && id <= 177 && (id - 109) % 4 == 0;
|}
|
|vec3 Obs07LampColor(int id){
|	const vec3 lampColor[18] = vec3[18](
|		vec3(1.0, 0.4, 0.1), vec3(0.2), vec3(0.0, 0.259, 1.0), vec3(0.459, 0.263, 0.149), vec3(0.0, 0.839, 0.839),
|		vec3(0.329, 0.357, 0.388), vec3(0.263, 0.451, 0.0), vec3(0.153, 0.686, 1.0), vec3(0.631, 0.627, 0.624),
|		vec3(0.439, 0.89, 0.0), vec3(0.757, 0.098, 0.812), vec3(1.0, 0.459, 0.0), vec3(1.0, 0.553, 0.718),
|		vec3(0.569, 0.0, 1.0), vec3(0.859, 0.0, 0.0), vec3(1.0), vec3(1.0, 0.878, 0.0), vec3(1.0, 0.4, 0.1)
|	);
|	return lampColor[clamp((id - 109) / 4, 0, 17)];
|}
|
|// light strips do not count as walls
|bool Obs07Wall(ivec3 cell){
|	int id = obs07Voxel(cell);
|	return id != 0 && (id < 100 || id > 281);
|}
|
|// single recessed lamp, dir 1 = floor, -1 = ceiling
|bool Obs07BeamLamp(ivec3 lampCell, int dir){
|	if (!Obs07IsLamp(obs07Voxel(lampCell))) return false;
|	if (Obs07Solid(lampCell + ivec3(0, dir, 0))) return false;
|
|	int sides = int(Obs07Wall(lampCell + ivec3(1, 0, 0))) + int(Obs07Wall(lampCell - ivec3(1, 0, 0))) +
|	            int(Obs07Wall(lampCell + ivec3(0, 0, 1))) + int(Obs07Wall(lampCell - ivec3(0, 0, 1)));
|	if (sides < 3) return false;
|	// skip strip ends
|	for (int n = 0; n < 4; n++){
|		ivec3 side = lampCell + ivec3(n == 0 ? 1 : (n == 1 ? -1 : 0), 0, n == 2 ? 1 : (n == 3 ? -1 : 0));
|		if (Obs07IsLamp(obs07Voxel(side))) return false;
|	}
|	return true;
|}
|
|// cone mode
|const float obs07ConeBase = 0.27;
|const float obs07ConeMax = 0.5;
|const float obs07ConeEnd = 4.3;
|const float obs07ConeSpread = (obs07ConeMax - obs07ConeBase) / obs07ConeEnd;
|
|float Obs07ConeDensity(vec3 pos, vec3 center, float top, float dir){
|	float height = (pos.y - center.y) * dir;
|	if (height < 0.0 || height > top) return 0.0;
|	float radius = min(obs07ConeBase + obs07ConeSpread * height, obs07ConeMax);
|	vec2 offset = abs(pos.xz - center.xz);
|	float dist = mix(max(offset.x, offset.y), length(offset), clamp(height * 0.7, 0.0, 1.0));
|	float rim = min(0.12 + 0.1 * height, 0.3);
|	float edge = 1.0 - smoothstep(radius - rim, radius + rim, dist);
|	edge *= edge;
|	float endFade = 1.0 - smoothstep(obs07ConeEnd * 0.45, obs07ConeEnd, height);
|	float fade = exp2(-height / OBS07_LAMP_BEAM_LENGTH) * smoothstep(top, top - 0.3, height) * endFade * endFade;
|	return edge * fade * (obs07ConeBase / radius);
|}
|
|// glow mode
|const float obs07GlowHeight = 5.5;
|const float obs07GlowWidth = 2.2; // must fade out within the 5x5 search
|
|float Obs07GlowDensity(vec3 pos, vec3 center, float top, float dir){
|	float height = (pos.y - center.y) * dir;
|	if (height < 0.0 || height > top) return 0.0;
|	float side = length(pos.xz - center.xz);
|	float width = min(0.3 + 0.4 * height, 1.3);
|	float spread = exp2(-side * side / (width * width) * 1.442695);
|	float falloff = 1.0 / (1.0 + (height * height + side * side) * 0.8);
|	float ends = smoothstep(top, top - 0.5, height) * (1.0 - smoothstep(1.0, obs07GlowHeight, height)) * (1.0 - smoothstep(0.6, 2.0, side));
|	return spread * falloff * ends * 0.22;
|}
|
|float Obs07LampDensity(vec3 pos, vec3 center, float top, float dir){
|	#if OBS07_LAMP_BEAM_MODE == 0
|		return Obs07ConeDensity(pos, center, top, dir);
|	#else
|		return Obs07GlowDensity(pos, center, top, dir);
|	#endif
|}
|
|vec3 Obs07ConeLight(ivec3 lampCell, int dir, vec3 origin, vec3 rayDir, float rayLength, float noise, vec3 worldOffset){
|	float top = 0.0;
|	float fdir = float(dir);
|	for (int k = 1; k <= OBS07_LAMP_BEAM_HEIGHT; k++){
|		if (Obs07Solid(lampCell + ivec3(0, k * dir, 0))) break;
|		top = float(k);
|	}
|	if (top < 0.5) return vec3(0.0);
|
|	#if OBS07_LAMP_BEAM_MODE == 0
|		top = min(top, obs07ConeEnd);
|		float topRadius = min(obs07ConeBase + obs07ConeSpread * top, obs07ConeMax) + min(0.12 + 0.1 * top, 0.3);
|	#else
|		top = min(top, obs07GlowHeight);
|		float topRadius = obs07GlowWidth;
|	#endif
|	vec3 center = vec3(vec2(lampCell.xz) + 0.5, float(lampCell.y + max(dir, 0))).xzy;
|	vec3 boxMin = center - vec3(topRadius, max(-fdir, 0.0) * top, topRadius);
|	vec3 boxMax = center + vec3(topRadius, max(fdir, 0.0) * top, topRadius);
|
|	vec3 invDir = 1.0 / rayDir;
|	vec3 t0 = (boxMin - origin) * invDir;
|	vec3 t1 = (boxMax - origin) * invDir;
|	float tNear = max(max(max(min(t0.x, t1.x), min(t0.y, t1.y)), min(t0.z, t1.z)), 0.0);
|	float tFar = min(min(min(max(t0.x, t1.x), max(t0.y, t1.y)), max(t0.z, t1.z)), rayLength);
|	if (tFar <= tNear) return vec3(0.0);
|
|	const int samples = 12;
|	float sampleLength = (tFar - tNear) / float(samples);
|	float light = 0.0;
|	for (int i = 0; i < samples; i++){
|		vec3 pos = origin + rayDir * (tNear + (float(i) + noise) * sampleLength);
|		float density = Obs07LampDensity(pos, center, top, fdir);
|		#ifdef OBS07_FOG_DRIFT
|			if (density > 0.0) density *= Obs07FogMotion(pos + worldOffset);
|		#endif
|		light += density;
|	}
|	light *= sampleLength;
|
|	light *= 0.35 + Obs07HenyeyGreenstein(-rayDir.y * fdir, 0.6) * 2.0;
|
|	// dust in the glow, half block grid
|	#ifdef OBS07_DUST_MOTES_IN_BEAM
|	if (OBS07_DUST > 0.0){
|		vec3 gridOrigin = (origin + worldOffset) * 2.0;
|		float tGrid = tNear * 2.0 + 1e-3;
|		vec3 gridCell = floor(gridOrigin + rayDir * tGrid);
|		vec3 cellStep = sign(rayDir);
|		vec3 gridDelta = abs(1.0 / rayDir);
|		vec3 tMax = (cellStep * (gridCell - gridOrigin) + max(cellStep, 0.0)) * gridDelta;
|		float time = frameTimeCounter * OBS07_DUST_SPEED;
|
|		float motes = 0.0;
|		for (int i = 0; i < 24; i++){
|			ivec3 c = ivec3(gridCell);
|			uint seed = uint(c.x) * 73856093u ^ uint(c.y) * 19349663u ^ uint(c.z) * 83492791u ^ 0x5bd1e995u;
|			vec3 h1 = Obs07Hash3(seed);
|
|			if (h1.x < OBS07_DUST_AMOUNT){
|				vec3 h2 = Obs07Hash3(seed);
|				vec3 mote = (gridCell + 0.5 + 0.3 * sin(time * (0.15 + h2 * 0.25) + h1 * 6.2831853)) * 0.5 - worldOffset;
|
|				float tm = dot(mote - origin, rayDir);
|				if (tm > 0.1 && tm < rayLength){
|					vec3 offset = origin + rayDir * tm - mote;
|					float radius = max(0.006 + h2.x * 0.005, tm * 0.0008);
|					float glint = exp2(-dot(offset, offset) / (radius * radius) * 1.442695);
|					float twinkle = 0.5 + 0.5 * pow(0.5 + 0.5 * sin(frameTimeCounter * (1.5 + h2.y * 3.0) + h2.z * 6.2831853), 4.0);
|					motes += Obs07LampDensity(mote, center, top, fdir) * glint * twinkle * (1.0 - smoothstep(8.0, 16.0, tm)) * (0.012 / max(radius, 0.012));
|				}
|			}
|
|			float tNext = min(min(tMax.x, tMax.y), tMax.z);
|			if (tNext > tFar * 2.0) break;
|			vec3 stepMask = step(tMax, vec3(tNext));
|			gridCell += cellStep * stepMask;
|			tMax += gridDelta * stepMask;
|		}
|		light += motes * 9.0 * OBS07_DUST;
|	}
|	#endif
|
|	// weaker when other lights are around
|	vec3 lampAir = vec3(lampCell) + vec3(0.5, 0.5 + fdir, 0.5) - float(VoxelSize / 2u) - fract(cameraPosition);
|	float above = luma(Obs07LpvLight(lampAir));
|	float around = luma(Obs07LpvLight(lampAir + vec3(2.0, 0.0, 0.0)) + Obs07LpvLight(lampAir - vec3(2.0, 0.0, 0.0)) +
|	                    Obs07LpvLight(lampAir + vec3(0.0, 0.0, 2.0)) + Obs07LpvLight(lampAir - vec3(0.0, 0.0, 2.0))) * 0.25;
|	float otherLight = max(around - above * 0.35, 0.0) / max(above, 1e-4);
|	light *= mix(1.0, 0.6, smoothstep(0.1, 0.6, otherLight));
|
|	return Obs07LampColor(obs07Voxel(lampCell)) * light;
|}
|
|void Obs07LampBeam(inout vec3 color, vec3 playerPos){
|	float rayLength = min(length(playerPos), 32.0);
|	vec3 rayDir = playerPos / max(length(playerPos), 1e-6);
|	rayDir = mix(rayDir, vec3(1e-5), lessThan(abs(rayDir), vec3(1e-5)));
|	float noise = blueNoise();
|
|	// voxel grid space
|	vec3 origin = gbufferModelViewInverse[3].xyz + fract(cameraPosition) + float(VoxelSize / 2u);
|	vec3 worldOffset = mod(floor(cameraPosition), 512.0) - float(VoxelSize / 2u);
|
|	ivec3 cell = ivec3(floor(origin));
|	ivec3 stepDir = ivec3(sign(rayDir));
|	vec3 tDelta = abs(1.0 / rayDir);
|	vec3 tMax = (vec3(stepDir) * (vec3(cell) - origin) + max(vec3(stepDir), 0.0)) * tDelta;
|
|	ivec4 lamps[4] = ivec4[4](ivec4(-1), ivec4(-1), ivec4(-1), ivec4(-1));
|	int lampCount = 0;
|	ivec3 lastSurface[2] = ivec3[2](ivec3(-1), ivec3(-1));
|	vec3 scattering = vec3(0.0);
|	float t = 0.0;
|
|	for (int i = 0; i < 40 && t < rayLength && lampCount < 4; i++){
|		float tNext = min(min(tMax.x, tMax.y), tMax.z);
|
|		if (!Obs07Solid(cell)){
|			// find the floor and ceiling, then lamps around them
|			for (int d = 0; d < 2; d++){
|				int dir = d == 0 ? 1 : -1;
|				ivec3 surface = ivec3(-1);
|				for (int k = 1; k <= OBS07_LAMP_BEAM_HEIGHT; k++){
|					if (Obs07Solid(cell - ivec3(0, k * dir, 0))){
|						surface = cell - ivec3(0, k * dir, 0);
|						break;
|					}
|				}
|
|				#if OBS07_LAMP_BEAM_MODE == 0
|					const int searchSize = 3;
|				#else
|					const int searchSize = 5;
|				#endif
|				// only read the new row when the floor cell moved by one
|				ivec3 moved = surface - lastSurface[d];
|				bool slide = moved.y == 0 && abs(moved.x) + abs(moved.z) == 1;
|				int searchCount = slide ? searchSize : searchSize * searchSize;
|				for (int n = 0; n < searchCount && surface.y >= 0 && surface != lastSurface[d]; n++){
|					ivec3 lampCell;
|					if (slide){
|						int side = n - searchSize / 2;
|						lampCell = surface + moved * (searchSize / 2) + (moved.x != 0 ? ivec3(0, 0, side) : ivec3(side, 0, 0));
|					}else{
|						lampCell = surface + ivec3(n % searchSize - searchSize / 2, 0, n / searchSize - searchSize / 2);
|					}
|					if (!Obs07BeamLamp(lampCell, dir)) continue;
|
|					bool known = false;
|					for (int j = 0; j < 4; j++) known = known || lamps[j] == ivec4(lampCell, dir);
|					if (known || lampCount >= 4) continue;
|					lamps[lampCount++] = ivec4(lampCell, dir);
|
|					scattering += Obs07ConeLight(lampCell, dir, origin, rayDir, rayLength, noise, worldOffset);
|				}
|				lastSurface[d] = surface;
|			}
|		}
|
|		if (tMax.x < tMax.y && tMax.x < tMax.z){
|			cell.x += stepDir.x; tMax.x += tDelta.x;
|		}else if (tMax.y < tMax.z){
|			cell.y += stepDir.y; tMax.y += tDelta.y;
|		}else{
|			cell.z += stepDir.z; tMax.z += tDelta.z;
|		}
|		t = tNext;
|	}
|
|	scattering *= Obs07NightFogAmount() * mix(OBS07_LIGHT_FOG_DAY, 1.0, Obs07Night());
|	scattering *= mix(1.0, 0.5, smoothstep(0.3, 1.0, luma(color) * exposureSSBO));
|	scattering *= 1.0 + OBS07_LAMP_BEAM_FOG * OBS07_LIGHT_FOG;
|	color += scattering * (TORCH_AMOUNT * 0.25 * OBS07_LAMP_BEAM * LPV_VL_FOG_ILLUMINATION_BRIGHTNESS / 50.0);
|}
@new shaders/lib/obs07_glass.glsl 7 1
|// OBS07: tinted shadow, dark glass keeps some light
|vec3 Obs07GlassShadow(vec4 translucentShadow){
|	float shadowAlpha = pow(1.0 - pow(1.0 - translucentShadow.a, 2.0), 5.0);
|	vec3 tint = normalize(translucentShadow.rgb * translucentShadow.rgb + 0.0001) * (1.0 - shadowAlpha);
|	tint += max(OBS07_DARK_GLASS_LIGHT - max(max(tint.r, tint.g), tint.b), 0.0);
|	return tint;
|}
